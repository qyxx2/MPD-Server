# Production image name/tag.
MPD_SERVER_IMAGE=mpd-server:latest

# Existing MPD 0.23.5 endpoint on the Synology LAN.
MPD_HOST=192.168.1.10
MPD_PORT=6600
MPD_PASSWORD=

# Host directories. Keep these outside the container lifecycle.
MPD_SERVER_DATA_DIR=/volume1/docker/mpd-server/data
MPD_SERVER_BACKUP_DIR=/volume1/docker/mpd-server/backups
MPD_SERVER_CONFIG_DIR=/volume1/docker/mpd-server/config
MUSIC_DIR=/volume1/music

# HTTP port exposed by the Music Server.
MPD_SERVER_PORT=8000

# Startup configuration (production Compose wires these into the container).
# General precedence: environment > snake_case JSON fields > defaults.
# JSON defaults to CONFIG_DIR/config.json, or DATABASE_PATH's parent/config.json.
# MPD saved endpoint takes priority; MPD_PASSWORD is environment-only and never JSON.
# Production Compose fixes APP_ENV=production and MPD_MODE=real.
MPD_URI_PREFIX=
# Explicit proof envelope: {endpoint:{host,port},mpd_version,result}.
# Bind to the active endpoint and confirm the version before granting operations.
# Historical bare probe results must be explicitly rebound after verification.
# MPD_CAPABILITIES_PATH=/config/mpd-capabilities.json
SCAN_INTERVAL_SECONDS=43200
DEBOUNCE_SECONDS=0.5
# Production Compose fixes HTTP_HOST=0.0.0.0, HTTP_PORT=8000, WORKERS=1.
# Change only MPD_SERVER_PORT above for the published NAS port.
# Select a unique currently observed ALSA output by name/plugin, never a saved ID.
# OUTPUT_NAME=USB DAC
OUTPUT_PLUGIN=alsa
# Runtime roots are injected separately from MUSIC_DIR (the NAS host mount source):
# MUSIC_ROOT=/music
# DATABASE_PATH=/data/music-server.db
# CONFIG_DIR=/config
# MPD_CONNECTION_PATH=/data/mpd-connection.json
# Optional MPD_CAPABILITIES_PATH/OUTPUT_NAME must be omitted if unused, not empty.
# Existing /data/mpd-connection.json keeps priority over MPD_HOST/MPD_PORT.
# Confirm the real NAS MUSIC_DIR and MPD music_directory refer to the same tree.
# IPv6 MPD_HOST is a bare address (no brackets); do not use container loopback
# for the NAS host. Verify routing/firewall from inside the target container.
# Build on the NAS for its native architecture; never assume local ARM64 matches.
